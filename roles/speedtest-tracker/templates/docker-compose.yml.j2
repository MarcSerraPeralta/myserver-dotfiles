services:
  speedtest-tracker:
    image: lscr.io/linuxserver/speedtest-tracker:latest
    container_name: speedtest-tracker
    restart: unless-stopped
    ports:
      - "8085:80"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Amsterdam
      - SPEEDTEST_SCHEDULE=0 7 * * * # Runs daily at 7:00 AM
      - APP_KEY={{ speed_tracker_app_key }}
      - APP_URL="https://speed.servidoret.com"
      - DB_CONNECTION=sqlite
    volumes:
      - /opt/speedtest-tracker/config:/config
